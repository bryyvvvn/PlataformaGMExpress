generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Rol {
  REPRESENTANTE
  TRABAJADOR
}

enum EstadoPedido {
  PENDIENTE     
  CONFIRMADO      
  EN_PRODUCCION 
  ENTREGADO      
  CANCELADO      
}

enum CategoriaPlato {
  ENTRADA
  FONDO
  POSTRE
  BEBESTIBLE
}

enum VarianteMenu {
  NORMAL
  VEGANO
  VEGETARIANO
  HIPOCALORICO
  SIN_GLUTEN
}

// --- TABLAS ---

model Empresa {
  id              Int       @id @default(autoincrement())
  nombre          String    @unique @db.VarChar(100)
  correo_contacto String?   @db.VarChar(100)
  usuarios        Usuario[]
  pedidos         Pedido[]
}

model Usuario {
  id        String   @id 
  nombre    String   @db.VarChar(100)
  rol       Rol      @default(TRABAJADOR)
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])
  pedidos   Pedido[]
}

// 🔥 NUEVA TABLA DE GUARNICIONES
model Guarnicion {
  id             Int             @id @default(autoincrement())
  nombre         String          @unique @db.VarChar(100)
  
  detallesPedido DetallePedido[] 
  menuDetalles   MenuDetalle[]   // Relación Muchos a Muchos implícita con el menú del día
}

model Plato {
  id           Int            @id @default(autoincrement())
  nombre       String         @unique @db.VarChar(100)
  url_imagen   String?        @db.Text
  categoria    CategoriaPlato @default(FONDO)  
  tipo         VarianteMenu   @default(NORMAL)
  
  menuDetalles   MenuDetalle[]
  detallesPedido DetallePedido[]
}

model MenuSemanal {
  id           Int           @id @default(autoincrement())
  fecha_inicio DateTime
  fecha_fin    DateTime
  creado_en    DateTime      @default(now())
  detalles     MenuDetalle[]
}

model MenuDetalle {
  id            Int          @id @default(autoincrement())
  dia_semana    String       
  fecha_dia     DateTime?
  
  menuSemanalId Int
  platoId       Int
  
  menuSemanal   MenuSemanal  @relation(fields: [menuSemanalId], references: [id], onDelete: Cascade)
  plato         Plato        @relation(fields: [platoId], references: [id])
  
  guarniciones  Guarnicion[] // Relación Muchos a Muchos implícita con Guarnicion
}

// --- TABLAS DE PEDIDOS ---

model Pedido {
  id        Int          @id @default(autoincrement())
  fecha     DateTime     @default(now())
  estado    EstadoPedido @default(PENDIENTE)
  
  empresaId Int
  usuarioId String
  
  empresa   Empresa      @relation(fields: [empresaId], references: [id])
  usuario   Usuario      @relation(fields: [usuarioId], references: [id])
  detalles  DetallePedido[]
}

model DetallePedido {
  id           Int          @id @default(autoincrement())
  pedidoId     Int
  platoId      Int
  
  // Guardamos qué acompañamiento eligió el usuario
  guarnicionId Int?         
  guarnicion   Guarnicion?  @relation(fields: [guarnicionId], references: [id])
  
  cantidad     Int          @default(1)
  
  pedido       Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  plato        Plato        @relation(fields: [platoId], references: [id])
}