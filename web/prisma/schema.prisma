generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Empresa {
  id                                Int               @id @default(autoincrement())
  nombre                            String            @unique @db.VarChar(100)
  correo_contacto                   String?           @db.VarChar(100)
  razonSocial                       String?           @db.VarChar(150)
  rut                               String?           @db.VarChar(20)
  nombreComercial                   String?           @db.VarChar(100)
  telefono                          String?           @db.VarChar(30)
  direccion                         String?           @db.VarChar(150)
  comuna                            String?           @db.VarChar(80)
  region                            String?           @db.VarChar(80)
  sector                            String?           @db.VarChar(80)
  nombreFaena                       String?           @db.VarChar(100)
  direccionFaena                    String?           @db.VarChar(150)
  representanteLegal                String?           @db.VarChar(150)
  rutRepresentanteLegal             String?           @db.VarChar(20)
  fechaNacimientoRepresentanteLegal DateTime?
  estado                            EstadoEmpresa     @default(ACTIVA)
  horaDespacho                      String?           @db.VarChar(5)
  esSucursal                        Boolean           @default(false)
  casaMatrizId                      Int?
  creado_en                         DateTime          @default(now())
  actualizado_en                    DateTime          @default(now())
  ContactoEmpresa                   ContactoEmpresa[]
  ConvenioEmpresa                   ConvenioEmpresa?
  casaMatriz                        Empresa?          @relation("SucursalesEmpresa", fields: [casaMatrizId], references: [id])
  pedidosManuales                   PedidoManual[]
  pedidos                           Pedido[]
  sucursales                        Empresa[]         @relation("SucursalesEmpresa")
  usuarios                          Usuario[]

  @@index([estado])
  @@index([casaMatrizId])
  @@index([rut])
}

model Usuario {
  id             String   @id
  nombreUsuario  String?  @db.VarChar(100)
  rol            Rol      @default(TRABAJADOR)
  rut            String?  @unique @db.VarChar(20) // 🔥 NUEVO: Opcional para que no choque con Clerk
  empresaId      Int?
  correo         String?  @db.VarChar(100)
  pedidos        Pedido[]
  empresa        Empresa? @relation(fields: [empresaId], references: [id])
  diasBloqueados Int[]    @default([])
  nombre         String?
  apellido       String?
  fcmToken       String?  @db.Text

  @@index([empresaId, rol])
}

model Guarnicion {
  id                 Int                @id @default(autoincrement())
  nombre             String             @unique @db.VarChar(100)
  detallesPedido     DetallePedido[]
  menuDiaSelecciones MenuDiaSeleccion[]
  menuDetalles       MenuDetalle[]      @relation("GuarnicionToMenuDetalle")
}

model Plato {
  id             Int                @id @default(autoincrement())
  nombre         String             @unique @db.VarChar(100)
  url_imagen     String?
  categoria      CategoriaPlato     @default(FONDO)
  tipo           VarianteMenu       @default(NORMAL)
  detallesPedido DetallePedido[]
  menuDetalles   MenuDetalle[]
  menuDiaBebidas MenuDiaSeleccion[] @relation("MenuDiaBebida")

  calorias      Int?
  proteinas     Int?
  carbohidratos Int?
  grasas        Int?
}

model MenuSemanal {
  id                 Int                @id @default(autoincrement())
  fecha_inicio       DateTime
  fecha_fin          DateTime
  creado_en          DateTime           @default(now())
  detalles           MenuDetalle[]
  menuDiaSelecciones MenuDiaSeleccion[]
}

model MenuDetalle {
  id                        Int                       @id @default(autoincrement())
  dia_semana                String
  menuSemanalId             Int
  platoId                   Int
  fecha_dia                 DateTime?
  menuSemanal               MenuSemanal               @relation(fields: [menuSemanalId], references: [id], onDelete: Cascade)
  plato                     Plato                     @relation(fields: [platoId], references: [id])
  menuDiaEntradaSelecciones MenuDiaEntradaSeleccion[]
  seleccionesEntrada        MenuDiaSeleccion[]        @relation("MenuDiaEntrada")
  seleccionesFondo          MenuDiaSeleccion[]        @relation("MenuDiaFondo")
  seleccionesPostre         MenuDiaSeleccion[]        @relation("MenuDiaPostre")
  guarniciones              Guarnicion[]              @relation("GuarnicionToMenuDetalle")

  @@index([menuSemanalId, fecha_dia])
}

model MenuDiaSeleccion {
  id                    Int                       @id @default(autoincrement())
  fecha_dia             DateTime
  creado_en             DateTime                  @default(now())
  actualizado_en        DateTime                  @updatedAt
  menuSemanalId         Int
  entradaDetalleId      Int
  fondoDetalleId        Int
  postreDetalleId       Int
  guarnicionId          Int?
  bebidaPlatoId         Int?
  entradasSeleccionadas MenuDiaEntradaSeleccion[]
  bebidaPlato           Plato?                    @relation("MenuDiaBebida", fields: [bebidaPlatoId], references: [id])
  entradaDetalle        MenuDetalle               @relation("MenuDiaEntrada", fields: [entradaDetalleId], references: [id])
  fondoDetalle          MenuDetalle               @relation("MenuDiaFondo", fields: [fondoDetalleId], references: [id])
  guarnicion            Guarnicion?               @relation(fields: [guarnicionId], references: [id])
  menuSemanal           MenuSemanal               @relation(fields: [menuSemanalId], references: [id], onDelete: Cascade)
  postreDetalle         MenuDetalle               @relation("MenuDiaPostre", fields: [postreDetalleId], references: [id])

  @@unique([menuSemanalId, fecha_dia])
  @@index([entradaDetalleId])
  @@index([fondoDetalleId])
  @@index([postreDetalleId])
  @@index([guarnicionId])
}

model Pedido {
  id        Int             @id @default(autoincrement())
  fecha     DateTime        @default(now())
  estado    EstadoPedido    @default(PENDIENTE)
  empresaId Int
  usuarioId String
  observacion String? @db.VarChar(500)
  detalles  DetallePedido[]
  empresa   Empresa         @relation(fields: [empresaId], references: [id])
  usuario   Usuario         @relation(fields: [usuarioId], references: [id])
  esCena                Boolean          @default(false) 
  tipoCena              String?          @db.VarChar(50) 

  @@index([empresaId, fecha])
}

model PedidoManual {
  id             Int      @id @default(autoincrement())
  empresaId      Int
  fecha          DateTime
  cantidad       Int
  observacion    String?  @db.VarChar(500)
  creado_por     String?  @db.VarChar(100)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt
  empresa        Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@index([fecha])
  @@index([empresaId, fecha])
}

model DetallePedido {
  id           Int         @id @default(autoincrement())
  pedidoId     Int
  platoId      Int
  cantidad     Int         @default(1)
  guarnicionId Int?
  guarnicion   Guarnicion? @relation(fields: [guarnicionId], references: [id])
  pedido       Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  plato        Plato       @relation(fields: [platoId], references: [id])
}

model ConfiguracionSistema {
  id                        Int      @id @default(1)
  horaLimite                String   @default("10:00") @db.VarChar(5)
  diasAnticipacion          Int      @default(2)
  actualizadoEn             DateTime @default(now())
  mensajePedidoTrabajadores String?
}

model ContactoEmpresa {
  id               Int                 @id @default(autoincrement())
  empresaId        Int
  tipo             TipoContactoEmpresa
  nombresApellidos String?             @db.VarChar(150)
  rut              String?             @db.VarChar(20)
  rolCargo         String?             @db.VarChar(100)
  telefono         String?             @db.VarChar(30)
  email            String?             @db.VarChar(100)
  fechaNacimiento  DateTime?
  activo           Boolean             @default(true)
  creado_en        DateTime            @default(now())
  actualizado_en   DateTime            @default(now())
  Empresa          Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([tipo])
}

model ConvenioEmpresa {
  id                    Int              @id @default(autoincrement())
  empresaId             Int              @unique
  permitePlato          Boolean          @default(true)
  permiteEntrada        Boolean          @default(true)
  permitePostre         Boolean          @default(true)
  permitePan            Boolean          @default(true)
  permiteJugo           Boolean          @default(true)
  permiteBebida         Boolean          @default(false)
  permiteAguaSaborizada Boolean          @default(false)
  trabajaFinDeSemana    Boolean          @default(false)
  permiteCena           Boolean          @default(false)
  tipoEmpaquetado       TipoEmpaquetado?
  creado_en             DateTime         @default(now())
  actualizado_en        DateTime         @default(now())
  Empresa               Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model MenuDiaEntradaSeleccion {
  id                 Int              @id @default(autoincrement())
  menuDiaSeleccionId Int
  menuDetalleId      Int
  orden              Int
  menuDetalle        MenuDetalle      @relation(fields: [menuDetalleId], references: [id])
  menuDiaSeleccion   MenuDiaSeleccion @relation(fields: [menuDiaSeleccionId], references: [id], onDelete: Cascade)

  @@unique([menuDiaSeleccionId, menuDetalleId])
  @@index([menuDetalleId])
  @@index([menuDiaSeleccionId])
}

model ExportacionProduccion {
  id               Int      @id @default(autoincrement())
  fecha            String   @db.VarChar(10)
  pedidosIncluidos Int
  creadoEn         DateTime @default(now())
  creadoPor        String?  @db.VarChar(150)

  @@index([fecha])
}

enum Rol {
  REPRESENTANTE
  TRABAJADOR
  ADMIN
}

enum EstadoPedido {
  PENDIENTE
  ENTREGADO
  CANCELADO
  CONFIRMADO
  EN_PRODUCCION
}

enum CategoriaPlato {
  ENTRADA
  FONDO
  POSTRE
  BEBIDA
  JUGO
  AGUA_SABORIZADA
  CANJE
  SANDWICH
  SNACK
}

enum VarianteMenu {
  NORMAL
  VEGANO
  HIPOCALORICO
  VEGETARIANO
  PLATO_UNICO
}

enum EstadoEmpresa {
  ACTIVA
  INACTIVA
}

enum TipoContactoEmpresa {
  TITULAR
  SUPLENTE
  COBRANZA
}

enum TipoEmpaquetado {
  BOWL_CRAFT
  C10_ALUMINIO
  SERVICIO_TRADICIONAL_PLATO
}
